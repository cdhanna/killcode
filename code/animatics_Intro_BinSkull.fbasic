_animIntroBinSkull:
  GOSUB _resetAnim

  w# = 512
  h# = 512

  a# = w# / h#
  y# = (render width()-200) / a#
  x# = (render height()-200) * a#


  `first panel
  anims(0) = {
    textureId = 0,
    startTimeMs = 200
    endTimeMs = 10 * 1000
    startPos = {
      x = 100,
      y = 100
    }
    startSize = {
      x = render width() - 200
      y = render height() - 200
    }
    color = rgb(0, 0, 0)
  }

  ` city backdrop, panel 1 486x343
  anims(1) = {
    textureId = TEX_BINARY_BACKGROUND,
    startTimeMs = 200
    lockTime = 5 * 1000
    endTimeMs = 5 * 1000

    startPos = {
      x = 100,
      y = 100
    }
    endPos = {
      x = 100,
      y = 80
    }
    startSize = {
      x = render width() - 200
      y = y#
    }
    color = rgb(255, 255, 255)
    animMaskIndex = 1 ` use the index+1
  }

 

  ` load the next image

  animCount = 2

RETURN