_setupAnimatics:

  ` setup the main backdrop
  animBackdropSprite = reserve sprite id(animBackdropSprite)
  sprite animBackdropSprite, 0, 0, 0
  color Sprite animBackdropSprite, rgb(0,0,0)
  size sprite animBackdropSprite, render width(), render height()
  set sprite offset animBackdropSprite, 0, 0
  order sprite animBackdropSprite, ORDER_ANIM
  set sprite alpha animBackDropSprite, 0

  animBackdropTween = reserve tween id(animBackdropTween)

  effect 1, "mask"

  remstart
    An animatic is made up of several little animations. 
    To control this, we'll have a big array of anim objects
    and they get setup programmatically.

    Then we run through the anim array until all of them are complete. 
    At that point, the animatic is complete. 


  remend

  global MAX_ANIM_COUNT = 200
  DIM anims(MAX_ANIM_COUNT) as anim
  anim as anim
  animCount = 0


  dim animSpriteIds(MAX_ANIM_COUNT)
  for n = 0 to MAX_ANIM_COUNT - 1
    reserve sprite id(animSpriteIds(n))
  next

  ` reserve some panel textures
  ` global MAX_PANEL_COUNT = 10
  ` DIM panels(MAX_PANEL_COUNT)
  ` panelCount = 0
  ` for n = 0 to len(panels) - 1
  `   panels(n) = reserve render target id(panels(n))
  ` next

RETURN

_playAnimatic:

  ` bring in the backdrop
  ` show sprite animbackdropsprite
  create basic tween animBackdropTween, 0, 255, 500, 0
  while is tween done(animbackdroptween) = 0
    set sprite alpha animbackdropsprite, tweenVal(animBackdropTween)
    sync
  endwhile

  highestEndMs = 0

  ` setup all the sprites
  for n = 0 to animCount - 1
    anim = anims(n)

    anim.pos = anim.startPos
    anim.size = anim.startSize

    sprite animSpriteIds(n), anim.pos.x, anim.pos.y, anim.textureId
    set sprite offset animSpriteIds(n), 0, 0
    size sprite animSpriteIds(n), anim.size.x, anim.size.y
    order sprite animSpriteIds(n), ORDER_ANIM + n + 1
    set sprite alpha animSpriteIds(n), 255
    if anim.endTimeMs > highestEndMs
      highestEndMs = anim.endTimeMs
    endif

    if anim.animMaskIndex
      set sprite effect animSpriteIds(n), 1
    else 
      set sprite effect animSpriteIds(n), 0
    endif

    if anim.color <> 0 then color sprite animSpriteIds(n), anim.color

    anims(n) = anim
    ` set sprite gizmo thickness animSpriteIds(n), anim.borderWidth 
  next

  ` correct any animations
  for n = 0 to animCount - 1
    anim = anims(n)
    if anim.endTimeMs <= 0
      anim.endTimeMs = highestEndMs
    endif
    if anim.locktime <= 0
      anim.lockTime = anim.endTImeMs
    endif
    if anim.fadeOutTimems <= 0
      anim.fadeOutTimeMs = 200
    endif
    if anim.fadeInTimeMs <= 0
      anim.fadeInTimeMs = 200
    endif
    anims(n) = anim
  next


  animStartMs = timer()


  do
  
    time = timer() - animStartMs

    anyLeft = 0

    for n = 0 to animCount - 1
      anim = anims(n)

      ` how many ms away from the start are we? 
      `  negative numbers are leading up to the start time, 
      `  positive numbers are into the animation. 
      animTime = time - anim.startTimeMs

      fadeInTime = -anim.fadeInTimeMs
      fadeInRatio# = 1 - max(0, min(1, (fadeInTime - animTime) / (anim.fadeInTimeMs+1) ))`(-500 - -300)/-500 = -200 /-500 = -.2

      fadeOutTime = (anim.endTimeMs-anim.startTimeMs) - anim.fadeOutTimeMs
      fadeOutRatio# = max(0, min(1, (fadeOutTime - animTime) / (anim.fadeOutTimeMs + 1)))
      lockTime = (anim.lockTime-anim.startTimeMs)

      if animTime < 0
        set sprite alpha animSpriteIds(n), fadeInRatio# * 255
      else
        set sprite alpha animSpriteIds(n), fadeOutRatio# * 255
      endif

      animRatio# = max(0, min(1, 1 - ((lockTime - animTime + 0.0) / (lockTime - fadeInTime)))) 
      ` print "anim ratio", animRatio#


      if anim.endPos.x <> 0 
        anim.pos.x = anim.startPos.x + animRatio# * (anim.endPos.x - anim.startPos.x)
        anim.pos.y = anim.startPos.y + animRatio# * (anim.endPos.y - anim.startPos.y)
        position sprite animSpriteIds(n), anim.pos.x, anim.pos.y
      endif
      if anim.endSize.x <> 0
        anim.size.x = anim.startSize.x + animRatio# * (anim.endSize.x - anim.startSize.x)
        anim.size.y = anim.startSize.y + animRatio# * (anim.endSize.y - anim.startSize.y)
        size sprite animSpriteIds(n), anim.size.x, anim.size.y
      endif

      anims(n) = anim


      if (anim.animMaskIndex)
        ` set sprite 
        ` maskSpriteId = animSpriteIds(anim(maskSpriteId-1))
        panel as anim = anims(anim.animMaskIndex - 1)

        sw# = anim.size.x
        sh# = anim.size.y
        sx# = anim.pos.x
        sy# = anim.pos.y
        px# = panel.pos.x
        py# = panel.pos.y
        pw# = panel.size.x
        ph# = panel.size.y
        
        uvX1# = (px# - sx#) / sw#
        uvX2# = ((px# + pw#) - sx#) / sw#
        uvY1# = (py# - sy#) / sh#
        uvY2# = ((py# + ph#) - sy#) / sh#

        set sprite all texcoord1 animSpriteIds(n), uvX1#, uvY1#, uvX2#, uvY2#
      endif


      if time < anim.endTimeMs
        anyLeft = 1
      endif


    next

    if not anyLeft
      exit
    endif
    sync
  loop


  create basic tween animBackdropTween, 255, 0, 500, 0
  while is tween done(animbackdroptween) = 0
    set sprite alpha animbackdropsprite, tweenVal(animBackdropTween)
    sync
  endwhile

RETURN

type anim

  `[REQUIRED] the sprite's texture
  textureId

  `[REQUIRED] at what point does this animation enter
  startTimeMs as float

  `[REQUIRED] at what point does this animation exit
  endTimeMs as float

  startPos as iVec
  startSize as iVec
  pos as iVec
  size as iVec

  `[OPTIONAL] 
  fadeInTimeMs as float

  `[OPTIONAL] 
  fadeOutTimeMs as float

  lockTime 
  endPos as iVec
  endSize as iVec

  color
  animMaskIndex
  borderWidth
endtype


_resetAnim:
  for n = 0 to MAX_ANIM_COUNT - 1
    anim = anims(n)
    ` anim.color = rgb(255, 255, 255)
    anims(n) = anim
  next
RETURN

function addAnim(textureId, duration, pos as iVec, size as iVec)

endfunction

` setup a test animation
_animTest:
  GOSUB _resetAnim
  anims(0) = {
    textureId = 0,
    startTimeMs = 200
    lockTime = 1000
    startPos = {
      x = 100,
      y = 100
    },
    endPos = {
      x = 200,
      y = 0
    }
    startSize = {
      x = 300
      y = 300
    }
    borderWidth = 12
    color = rgb(255, 146, 146)
  }

  anims(1) = {
    textureId = happyDanceTextures(2),
    startTimeMs = 400
    endTimeMs = 4000
    ` lockTime = 1000
    startPos = {
      x = 150,
      y = 100
    },
    startSize = {
      x = 400
      y = 400
    },
    endSize = {
      x = 300, y = 300
    }

    ` animMaskIndex = 1 ` use the index+1
  }

  animCount = 2

RETURN


